# ===== DEPLOYABLE MODEL WEIGHTS (tracked deliberately — private repo) =====
# Only the best.pt of each detector is versioned; last.pt, plots and CSVs stay out.
# Git will not descend into an excluded directory, so every level of the path must
# be re-included before the file itself can be matched.
!backend/scanning/ml/runs/
backend/scanning/ml/runs/*
!backend/scanning/ml/runs/vehicle_detector/
backend/scanning/ml/runs/vehicle_detector/*
!backend/scanning/ml/runs/vehicle_detector/weights/
backend/scanning/ml/runs/vehicle_detector/weights/*
!backend/scanning/ml/runs/vehicle_detector/weights/best.pt
!backend/scanning/ml/runs/plate_detector/
backend/scanning/ml/runs/plate_detector/*
!backend/scanning/ml/runs/plate_detector/weights/
backend/scanning/ml/runs/plate_detector/weights/*
!backend/scanning/ml/runs/plate_detector/weights/best.pt

# Docker build artefact: the built SPA copied into the backend image
backend/frontend_build/

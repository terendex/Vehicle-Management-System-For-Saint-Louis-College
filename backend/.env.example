# Backend .env.example
# Copy this file to .env and fill in your actual values.

# Django
SECRET_KEY=your-secret-key
# DEBUG is read from this variable now. It MUST be false in production —
# Django refuses to start without a SECRET_KEY when it is off.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Production / Railway only ─────────────────────────────────────────────────
# Railway sets RAILWAY_PUBLIC_DOMAIN itself; it is appended to ALLOWED_HOSTS and
# CSRF_TRUSTED_ORIGINS automatically, so neither needs editing per deploy.
# Add any extra custom domain here (scheme optional).
CSRF_TRUSTED_ORIGINS=
# Django admin is NOT at /admin/ — the React app owns that path on the shared
# origin. Change this to something unguessable if the admin is left enabled.
DJANGO_ADMIN_URL=django-admin
# Set false only if you terminate TLS yourself.
SECURE_SSL_REDIRECT=true
# Set false to deploy without running migrations at container start.
RUN_MIGRATIONS=true
# Default page size for endpoints that opt into pagination with ?page=.
DRF_PAGE_SIZE=50

# ── Database ───────────────────────────────────────────────────────────────────
# Hosted (Neon): paste your Neon connection string here, leave DB_* blank
DATABASE_URL=

# Local dev fallback (only used when DATABASE_URL is not set)
DB_NAME=plate_db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Cloudflare R2 (image storage + ML weight sync) ────────────────────────────
# Set USE_R2=true to store uploaded images in R2 instead of local disk.
# R2_* credentials are also used by sync_ml_weights even when USE_R2=false.
USE_R2=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
# R2_PUBLIC_URL is your bucket's public URL, e.g. pub-xxxx.r2.dev or a custom domain
R2_PUBLIC_URL=

# ── Email ──────────────────────────────────────────────────────────────────────
# Gmail over SMTP. Correct for local dev and for the campus machine; NOT usable
# on Railway, which blocks outbound SMTP (ports 25/465/587) by dropping the
# packets — so a send just hangs until EMAIL_TIMEOUT and fails with no useful
# error. Use the HTTPS block below there instead.
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Railway only — send over HTTPS through Resend rather than SMTP. Setting
# EMAIL_BACKEND is what switches transports; leave all three unset on campus.
# The sender domain must be verified in the Resend dashboard (Resend is not
# tied to the account's own address the way Gmail is); `onboarding@resend.dev`
# works before the school's DNS records exist.
# EMAIL_BACKEND=config.email_backends.ResendEmailBackend
# RESEND_API_KEY=re_xxxxxxxx
# DEFAULT_FROM_EMAIL=noreply@spvvs.slc-sflu.edu.ph

# Check whichever transport this host uses actually works:
#   python manage.py check_email --to you@example.com

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ── JWT ────────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Celery + Redis ─────────────────────────────────────────────────────────────
# REDIS_URL also drives the Channels layer and the Django cache. Without it the
# WebSocket layer falls back to in-memory, which cannot deliver a broadcast sent
# from the Celery worker (a different process) to a browser.
# On Railway, add the Redis plugin and set this to ${{Redis.REDIS_URL}}.
#
# To make live updates reach the CAMPUS half too, this must be an instance the
# campus machine can also reach (Railway's plugin Redis is internal-only; a
# managed Redis with a public rediss:// endpoint avoids needing a TCP proxy).
# Set the same value in the campus .env, then verify with:
#   python manage.py check_realtime --send   /   --listen
REDIS_URL=
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ── ML Feedback Loop ───────────────────────────────────────────────────────────
ML_SAMPLE_BATCH_SIZE=50
ML_AUTO_RETRAIN_ENABLED=true

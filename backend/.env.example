# Backend .env.example
# Copy this file to .env and fill in your actual values.

# Django
SECRET_KEY=your-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ───────────────────────────────────────────────────────────────────
# Hosted (Neon): paste your Neon connection string here, leave DB_* blank
DATABASE_URL=

# Local dev fallback (only used when DATABASE_URL is not set)
DB_NAME=plate_db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Cloudflare R2 (image storage + ML weight sync) ────────────────────────────
# Set USE_R2=true to store uploaded images in R2 instead of local disk.
# R2_* credentials are also used by sync_ml_weights even when USE_R2=false.
USE_R2=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
# R2_PUBLIC_URL is your bucket's public URL, e.g. pub-xxxx.r2.dev or a custom domain
R2_PUBLIC_URL=

# ── Email ──────────────────────────────────────────────────────────────────────
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ── JWT ────────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Celery + Redis ─────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ── ML Feedback Loop ───────────────────────────────────────────────────────────
ML_SAMPLE_BATCH_SIZE=50
ML_AUTO_RETRAIN_ENABLED=true

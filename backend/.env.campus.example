# ─────────────────────────────────────────────────────────────────────────────
#  Campus instance — .env template
#
#  This is the on-site half of the hybrid setup. It runs on a machine INSIDE the
#  campus network so it can reach the cameras at 192.168.137.x, which a cloud
#  container never can. It talks to the SAME Neon database and the SAME R2
#  bucket as the Railway deployment, so both halves show identical data.
#
#  Copy to backend/.env on the campus machine and fill in the two marked values.
#  Costs nothing to run — it is your own hardware.
# ─────────────────────────────────────────────────────────────────────────────

DJANGO_SETTINGS_MODULE=config.settings

# ── Django ────────────────────────────────────────────────────────────────────
DEBUG=false

# MUST be byte-identical to the Railway SECRET_KEY. JWTs are signed with it, so
# a mismatch means a token issued by one half is rejected by the other.
SECRET_KEY=<paste the same SECRET_KEY used on Railway>

# The LAN address guards will type into their browsers. Add the machine's fixed
# IP and hostname. Django rejects any Host header not listed here.
ALLOWED_HOSTS=localhost,127.0.0.1,<campus-machine-lan-ip>

# The LAN has no TLS certificate, so HTTPS redirection must be off or every
# request bounces to an https:// URL that nothing is serving.
SECURE_SSL_REDIRECT=false

# Railway owns the schema. Both halves share one database, and letting two
# instances race to migrate it — possibly from different commits — is how a
# shared database gets corrupted. Leave this false and deploy schema changes
# through Railway only.
RUN_MIGRATIONS=false

# ── Database — the SAME Neon instance Railway uses ────────────────────────────
DATABASE_URL=<paste the same DATABASE_URL used on Railway>

# ── R2 — the SAME bucket Railway uses ─────────────────────────────────────────
# Required, not optional: with local storage a photo uploaded at the gate would
# be invisible to anyone on the Railway URL.
USE_R2=true
R2_ACCESS_KEY_ID=<same as Railway>
R2_SECRET_ACCESS_KEY=<same as Railway>
R2_BUCKET_NAME=<same as Railway>
R2_ACCOUNT_ID=<same as Railway>
R2_PUBLIC_URL=<same as Railway>

# ── Email ─────────────────────────────────────────────────────────────────────
# NOT the same as Railway — this is the one setting the two halves deliberately
# differ on. Railway blocks outbound SMTP, so it sends over HTTPS through Brevo
# instead; this machine has unrestricted egress, so plain Gmail on port 587
# works and is simpler. Do not copy Railway's EMAIL_BACKEND / BREVO_API_KEY
# here, and leave EMAIL_BACKEND unset so the SMTP default applies.
#
# Use the SAME Gmail address Railway sends from, so a student sees one
# consistent sender whichever half emailed them.
EMAIL_HOST_USER=<the Gmail address>
EMAIL_HOST_PASSWORD=<its 16-character Gmail App Password>

# Confirm it before relying on it:
#   python manage.py check_email --to you@example.com

# ── URLs ──────────────────────────────────────────────────────────────────────
# Point at THIS machine — this is what guards type in at the gate.
FRONTEND_URL=http://<campus-machine-lan-ip>:8000
BACKEND_URL=http://<campus-machine-lan-ip>:8000
CSRF_TRUSTED_ORIGINS=http://<campus-machine-lan-ip>:8000

# But emails must NOT use the LAN address above. A student reading their
# approval on mobile data cannot reach 192.168.x.x: the QR image would never
# load and the password-reset link would go nowhere. Every link and image inside
# an email uses this instead, so point it at the public Railway domain.
# Railway itself does not need this set — there it defaults to FRONTEND_URL.
PUBLIC_SITE_URL=https://spvvs-slc-sflu.up.railway.app

# ── Django admin ──────────────────────────────────────────────────────────────
# Same prefix as Railway; the React app owns /admin on this origin too.
DJANGO_ADMIN_URL=django-admin

# ── Channels / Redis ──────────────────────────────────────────────────────────
# THIS IS WHAT MAKES SCREENS ON BOTH HALVES UPDATE LIVE.
#
# The two halves already share one database, so data is identical the instant
# it is written. But a browser sitting on a page is only *told* by the half it
# is connected to. Set this to a Redis BOTH machines can reach and a scan at
# the gate refreshes an off-campus screen immediately; leave it unset and the
# off-campus user sees the change only on their next refresh.
#
# It must be the SAME instance as Railway's, and reachable from this LAN:
#   - a managed Redis with a public TLS endpoint works directly (rediss://…),
#     which avoids paying for a raw TCP proxy;
#   - Railway's own Redis plugin is internal-only, so sharing it needs that
#     paid TCP proxy enabled.
# A redis://127.0.0.1 address CANNOT link the halves — it is per-machine, and
# if nothing is listening there live updates die silently.
#
# After setting it on both halves, prove they are linked:
#   campus>   python manage.py check_realtime --listen
#   railway>  python manage.py check_realtime --send
# REDIS_URL=

# ── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── ML ────────────────────────────────────────────────────────────────────────
ML_SAMPLE_BATCH_SIZE=50
ML_AUTO_RETRAIN_ENABLED=true

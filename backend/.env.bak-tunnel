# ── Celery + Redis ─────────────────────────────────────────────────────────────
# For local dev (outside Docker) keep 127.0.0.1.
# docker-compose overrides these to redis://redis:6379/0 automatically.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ── CORS ───────────────────────────────────────────────────────────────────────

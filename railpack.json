{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.12",
    "node": "22"
  },
  "buildAptPackages": [
    "libgl1",
    "libglib2.0-0",
    "libgomp1"
  ],
  "steps": {
    "install": {
      "commands": [
        "python -m venv /app/.venv",
        { "path": "/app/.venv/bin" },
        "pip install --index-url https://download.pytorch.org/whl/cpu torch==2.12.0 torchvision==0.27.0",
        "pip install paddlepaddle==3.0.0",
        { "src": "requirements.txt", "dest": "requirements.txt" },
        "pip install -r requirements.txt"
      ]
    },
    "build": {
      "commands": [
        { "path": "/app/.venv/bin" },
        "npm --prefix frontend ci",
        "npm --prefix frontend run build",
        "rm -rf backend/frontend_build",
        "cp -r frontend/dist backend/frontend_build",
        "cd backend && DEBUG=false SECRET_KEY=build-only-not-a-real-secret python manage.py collectstatic --noinput --clear"
      ]
    }
  },
  "deploy": {
    "startCommand": "cd backend && sh start.sh",
    "aptPackages": [
      "libgl1",
      "libglib2.0-0",
      "libgomp1"
    ],
    "variables": {
      "PYTHONUNBUFFERED": "1",
      "YOLO_CONFIG_DIR": "/tmp/ultralytics",
      "MPLCONFIGDIR": "/tmp/matplotlib",
      "OMP_NUM_THREADS": "2"
    }
  }
}
